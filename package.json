{
	"name": "plugin-2d-frame",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "hoardodile plugin dev",
		"dev:data": "node scripts/dev-data.mjs",
		"build": "hoardodile plugin build",
		"watch": "hoardodile plugin build --watch",
		"detect:smoke": "hoardodile plugin run detect testdata --plugin-dir dist",
		"testdata": "node scripts/make-testdata.mjs",
		"lint": "biome check . && node scripts/check-kernel-purity.mjs && tsc --noEmit",
		"format": "biome check --write",
		"lint-staged": "lint-staged --max-arg-length=6000",
		"postinstall": "node scripts/setup-hooks.mjs",
		"test": "vitest run",
		"readme:check": "node scripts/check-readme.mjs",
		"release": "node scripts/release.mjs"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"release-it": {
		"git": {
			"commitMessage": "chore(release): v${version}",
			"tagName": "v${version}",
			"requireBranch": "main"
		},
		"github": {
			"release": false
		},
		"npm": {
			"publish": false
		},
		"plugins": {
			"@release-it/conventional-changelog": {
				"preset": {
					"name": "conventionalcommits"
				},
				"infile": "CHANGELOG.md"
			}
		},
		"hooks": {
			"after:bump": "node scripts/sync-version.mjs"
		}
	},
	"dependencies": {
		"@effect/atom-react": "4.0.0-rc.113",
		"@effect/platform-browser": "4.0.0-rc.113",
		"@hoardodile/sdk-react": "^0.2.0",
		"@hoardodile/sdk-server": "^0.2.0",
		"@hoardodile/sdk-types": "^0.2.0",
		"@hoardodile/sdk-web": "^0.2.0",
		"@hoardodile/ui": "^0.2.2",
		"effect": "4.0.0-rc.113",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@effect/language-service": "^0.87.2",
		"@effect/vitest": "4.0.0-rc.113",
		"@hoardodile/cli": "^0.2.0",
		"@hoardodile/host": "^0.2.0",
		"@hoardodile/workbench": "^0.2.0",
		"@release-it/conventional-changelog": "^12.0.0",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"jsdom": "^30.0.1",
		"lefthook": "^2.1.10",
		"lint-staged": "^17.3.0",
		"release-it": "^21.0.2",
		"shadcn": "^4.21.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"version": "0.1.3"
}
